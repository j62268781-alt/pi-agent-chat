    },
    {
      "label": "build:webview",
      "type": "shell",
      "command": "pnpm run build:webview",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "typecheck",
      "type": "shell",
      "command": "pnpm run typecheck",
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "watch:extension",
      "type": "shell",
      "command": "pnpm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
