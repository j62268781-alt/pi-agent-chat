# Whitelist-style ignore file: only the files below ship in the .vsix.
# The Vue webview bundles are inlined into dist/extension.cjs at build time,
# so `webview-vue/` and `src/` never need to be packaged.
**/*
!dist/extension.cjs
!dist/chunks/**/*.cjs
!l10n/**
!resources/**
!pi-extensions/**
!package.nls*.json
!README.md
!CHANGELOG.md
!LICENSE