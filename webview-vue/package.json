{
  "name": "@pi-agent-chat/webview-vue",
  "version": "1.0.0",
  "private": true,
  "description": "Vue 3 webviews for Pi Agent Chat: the chat panel and the settings panel. Each builds to a self-contained single-file HTML document that the extension host inlines with `?raw`.",
  "type": "module",
  "scripts": {
    "build": "node scripts/extract-model-icons.mjs && vite build --mode chat && vite build --mode settings",
    "build:chat": "node scripts/extract-model-icons.mjs && vite build --mode chat",
    "build:settings": "vite build --mode settings",
    "dev": "vite --mode chat",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "katex": "^0.18.1",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.16.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.15.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vue-tsc": "^2.2.0"
  }
}
